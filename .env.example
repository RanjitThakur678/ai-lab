# ============================================================================
# Dictionary Bot — Provider Configuration
# ============================================================================
# Choose your provider: openai | ollama | kimchi | custom
# Default: openai
PROVIDER=openai

# ============================================================================
# OpenAI (default)
# ============================================================================
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
# Optional overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# Ollama (local, free — no internet required after setup)
# ============================================================================
# Install: https://ollama.com
# Pull a model: ollama pull llama3.2
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# ============================================================================
# Kimchi (built-in provider)
# ============================================================================
# Uses your Kimchi session token. Do NOT hardcode — read from env.
# KIMCHI_API_KEY=your-kimchi-token
# KIMCHI_BASE_URL=https://llm.kimchi.dev/openai/v1
# KIMCHI_MODEL=kimi-k2.5

# ============================================================================
# Custom (any OpenAI-compatible endpoint)
# ============================================================================
# CUSTOM_API_KEY=your-api-key
# CUSTOM_BASE_URL=https://your-endpoint.example.com/v1
# CUSTOM_MODEL=your-model-name

# ============================================================================
# Shared parameters (applied to all providers)
# ============================================================================
# MAX_TOKENS=500
# TEMPERATURE=0.7
